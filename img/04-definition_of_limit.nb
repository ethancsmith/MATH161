      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"HoldForm", "[", 
            RowBox[{"f", "[", "x", "]"}], "]"}], "-", "l"}], "]"}], "<", 
         "\[Epsilon]"}], ",", 
        RowBox[{"0", "<", 
