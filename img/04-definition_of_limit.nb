          RowBox[{"x", "-", "x0"}], "]"}], "<", "\[Delta]"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plt", "=", 
