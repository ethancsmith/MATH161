     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmax", "=", 
   RowBox[{"xInt", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"del", "=", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"x0", "-", "xmin"}], "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"x0", "-", "xmax"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tolReg", "=", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"y", "-", "l"}], "]"}], "<", "eps"}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"x", "-", "x0"}], "]"}], "<", "del"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "c", ",", "d"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
