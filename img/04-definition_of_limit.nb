Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "*", "x"}], "-", "1"}], ",", 
        RowBox[{"x", "!=", "3"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", 
        RowBox[{"x", "==", "3"}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"x", "->", "x0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x0", "-", "0.5"}], ",", 
     RowBox[{"x0", "+", "0.5"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"f", "[", "a", "]"}], ",", 
     RowBox[{"f", "[", "b", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"f", "[", "a", "]"}], ",", 
     RowBox[{"f", "[", "b", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", "=", 
   RowBox[{"1", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modelPlt", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", " ", 
       RowBox[{"x", ",", "y"}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{
       RowBox[{"HoldForm", "[", 
        RowBox[{"f", "[", "x", "]"}], "]"}], "==", 
       RowBox[{"f", "[", "x", "]"}]}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"target", "=", 
   RowBox[{"{", 
    RowBox[{"x0", ",", "l"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"targetPnt", "=", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", "target", "}"}], ",", 
       RowBox[{"PlotMarkers", "->", "\"\<OpenMarkers\>\""}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"x0", ",", 
         RowBox[{"f", "[", "x0", "]"}]}], "}"}], "}"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"specLine", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"x", "==", "x0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "c", ",", "d"}], "}"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xInt", "=", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], "-", "l"}], "]"}], "<", "eps"}], ",", 
     "x", ",", "Reals"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmin", "=", 
   RowBox[{"xInt", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmax", "=", 
   RowBox[{"xInt", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"del", "=", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"x0", "-", "xmin"}], "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"x0", "-", "xmax"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tolReg", "=", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"y", "-", "l"}], "]"}], "<", "eps"}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"x", "-", "x0"}], "]"}], "<", "del"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "c", ",", "d"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Opacity", "[", "0.35", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Green", ",", 
          RowBox[{"Opacity", "[", "0.25", "]"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"BoundaryStyle", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Dashed"}], "}"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"HoldForm", "[", 
            RowBox[{"f", "[", "x", "]"}], "]"}], "-", "l"}], "]"}], "<", 
         RowBox[{"N", "[", "eps", "]"}]}], ",", 
        RowBox[{"0", "<", 
         RowBox[{"Abs", "[", 
          RowBox[{"x", "-", "x0"}], "]"}], "<", "\[Delta]"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plt", "=", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
   "modelPlt", ",", "\[IndentingNewLine]", "targetPnt", ",", 
    "\[IndentingNewLine]", "specLine", ",", "\[IndentingNewLine]", "tolReg", 
    ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Ticks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x0", "-", "del"}], ",", 
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<``-\[Delta]\>\"", ",", "x0"}], "]"}]}], "}"}], ",", 
         "x0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x0", "+", "del"}], ",", 
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<``+\[Delta]\>\"", ",", "x0"}], "]"}]}], "}"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"l", "-", "eps"}], ",", 
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<``-\[Epsilon]\>\"", ",", "l"}], "]"}]}], "}"}], ",", 
         "l", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"l", "+", "eps"}], ",", 
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<``+\[Epsilon]\>\"", ",", "l"}], "]"}]}], "}"}], ",", 
         
         RowBox[{"f", "[", "x0", "]"}]}], "}"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<ex1.png\>\"", ",", "plt"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
