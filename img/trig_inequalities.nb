Notebook[{
Cell[TextData[{
 "The picture below helps us see why the inequalities ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{"sin", "\[Theta]", "|", "\[LessEqual]", "|", "\[Theta]"}]}, 
        "Abs"], TraditionalForm], "errors" -> {}, "input" -> 
     "|\\sin\\theta|\\le |\\theta|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d2ab540-5795-4b19-bb57-fa43feac038b"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "1", "-", "cos", "\[Theta]", "\[LessEqual]", "|", "\[Theta]", "|"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "1-\\cos\\theta\\le|\\theta|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b18377a9-e126-4240-8599-c5e835a2c5e8"],
 "are both true at least for the \[OpenCurlyDoubleQuote]difficult case\
\[CloseCurlyDoubleQuote] when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[LessEqual]", "\[Theta]", "\[LessEqual]", "\[Pi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "0\\le\\theta\\le\\pi", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cbf2bc27-d528-4acf-ae81-0995832acd6c"],
 "."
}], "Text",
 CellChangeTimes->{{3.946036263705567*^9, 
  3.946036335775551*^9}},ExpressionUUID->"7517d3b3-2ea7-4d68-90ff-\
51d990d0c898"],

