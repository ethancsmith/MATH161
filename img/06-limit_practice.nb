Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"v0", "=", "120"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i0", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"i", "[", "r_", "]"}], "=", 
   RowBox[{"v0", "/", "r"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r0", "=", 
   RowBox[{"r", "/.", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"i", "[", "r", "]"}], "==", "i0"}], ",", "r"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r0", "-", "1"}], ",", 
     RowBox[{"r0", "+", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"c", ",", "d"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"i", "[", "b", "]"}], ",", 
     RowBox[{"i", "[", "a", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", "=", 
   RowBox[{"1", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modelPlt", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"i", "[", "r", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", " ", 
       RowBox[{
       "\"\<\!\(\*StyleBox[\"R\",FontSlant->\"Italic\"]\) (ohms)\>\"", ",", 
        "\"\<\!\(\*StyleBox[\"I\",FontSlant->\"Italic\"]\) (amps)\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"StringForm", "[", 
       RowBox[{
       "\"\<\!\(\*StyleBox[\"I\",FontSlant->\"Italic\"]\)(\!\(\*StyleBox[\"R\"\
,FontSlant->\"Italic\"]\)) = ``\>\"", ",", 
        RowBox[{
        "i", "[", "\"\<\!\(\*StyleBox[\"R\",FontSlant->\"Italic\"]\)\>\"", 
         "]"}]}], "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"target", "=", 
   RowBox[{"{", 
    RowBox[{"r0", ",", "i0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"targetPnt", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", "target", "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"specLine", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"r", "==", "r0"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "c", ",", "d"}], "}"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rInt", "=", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"i", "[", "r", "]"}], "-", "i0"}], "]"}], "<", "eps"}], ",", 
     "r", ",", "Reals"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rmin", "=", 
   RowBox[{"rInt", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rmax", "=", 
   RowBox[{"rInt", "[", 
    RowBox[{"[", 
     RowBox[{"-", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"del", "=", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"r0", "-", "rmin"}], "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"r0", "-", "rmax"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tolReg", "=", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"i", "-", "i0"}], "]"}], "<", "eps"}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"r", "-", "r0"}], "]"}], "<", "del"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "c", ",", "d"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Opacity", "[", "0.35", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Green", ",", 
          RowBox[{"Opacity", "[", "0.25", "]"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"BoundaryStyle", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Dashed"}], "}"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
          "\"\<\!\(\*StyleBox[\"I\",FontSlant->\"Italic\"]\)\>\"", "-", 
           "i0"}], "]"}], "<", "\[Epsilon]"}], ",", 
        RowBox[{"0", "<", 
         RowBox[{"Abs", "[", 
          RowBox[{
          "\"\<\!\(\*StyleBox[\"R\",FontSlant->\"Italic\"]\)\>\"", "-", 
           "\"\<\!\(\*SubscriptBox[StyleBox[\"R\",FontSlant->\"Italic\"], \"0\
\"]\)\>\""}], "]"}], "<", "\[Delta]"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"plt", "=", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
   "modelPlt", ",", "\[IndentingNewLine]", "targetPnt", ",", 
    "\[IndentingNewLine]", "specLine", ",", "\[IndentingNewLine]", "tolReg", 
    ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Ticks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r0", "-", "del"}], ",", 
           "\"\<\!\(\*SubscriptBox[StyleBox[\"R\",FontSlant->\"Italic\"], \"0\
\"]\)-\[Delta]\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "r0", ",", 
           "\"\<\!\(\*SubscriptBox[StyleBox[\"R\",FontSlant->\"Italic\"], \"0\
\"]\)\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r0", "+", "del"}], ",", 
           "\"\<\!\(\*SubscriptBox[StyleBox[\"R\",FontSlant->\"Italic\"], \"0\
\"]\)+\[Delta]\>\""}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i0", "-", "eps"}], ",", "\"\<5-\[Epsilon]\>\""}], "}"}], 
         ",", "i0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i0", "+", "eps"}], ",", "\"\<5+\[Epsilon]\>\""}], "}"}]}],
         "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<tol_reg.png\>\"", ",", "plt"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
